{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build OS Emulator",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "-pthread",
                "${workspaceFolder}/src/*.cpp",
                "-I${workspaceFolder}/include",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Custom cppbuild configuration."
        },
        {
            "label": "Build OS Emulator (build.bat)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Builds using build.bat, which auto-detects the g++ install."
        },
        {
            "label": "Build and Run OS Emulator",
            "type": "shell",
            "command": "${workspaceFolder}/main.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build OS Emulator (build.bat)",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}